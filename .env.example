DEEPSEEK_API_KEY=your-deepseek-api-key-here
# Optional: model used when --model is not provided.
# CODE_AGENT_MODEL=deepseek-v4-flash
# Optional: used only after transient failures exhaust normal retries.
# CODE_AGENT_FALLBACK_MODEL=deepseek-chat
# Per API attempt; retries are shown in the CLI instead of happening silently.
# CODE_AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=120
# CODE_AGENT_MODEL_TOTAL_TIMEOUT_SECONDS=390
# CODE_AGENT_MODEL_MAX_RETRIES=2
